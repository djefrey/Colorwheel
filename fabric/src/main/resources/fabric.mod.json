{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "https://djefrey.github.io/colorwheel/",
    "sources": "https://github.com/djefrey/Colorwheel",
    "issues": "https://github.com/djefrey/Colorwheel/issues"
  },
  "license": "${license}",
  "icon": "${mod_id}.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.djefrey.colorwheel.fabric.ClrwlFabric"
    ],
    "client": [
      "dev.djefrey.colorwheel.fabric.client.ClrwlFabricClient"
    ]
  },
  "mixins": [
    "colorwheel.mixins.json",
    "colorwheel.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "iris": ">=1.10.7"
  },
  "recommends": {
    "flywheel": "^1.0.0"
  },
  "suggests": {
    "colorwheel_patcher": ">=1.0.0"
  },
  "breaks": {
    "irisflw": "*"
  }
}
