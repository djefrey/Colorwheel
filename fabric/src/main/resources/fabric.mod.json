{
  "schemaVersion": 1,
  "id": "colorwheel",
  "version": "${version}",
  "name": "Colorwheel",
  "description": "Allows you to use Iris Shaders with Flywheel",
  "authors": [
    "djefrey"
  ],
  "contact": {
    "homepage": "https://djefrey.github.io/colorwheel/",
    "sources": "https://github.com/djefrey/Colorwheel",
    "issues": "https://github.com/djefrey/Colorwheel/issues"
  },
  "license": "LGPL",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.djefrey.colorwheel.fabric.ClrwlFabric"
    ],
    "client": [
      "dev.djefrey.colorwheel.fabric.client.ClrwlFabricClient"
    ]
  },
  "mixins": [
    "colorwheel.mixins.json",
    "colorwheel.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.5",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*",
    "iris": ">=1.7.0"
  },
  "recommends": {
    "flywheel": "^1.0.0"
  },
  "suggests": {
    "colorwheel_patcher": ">=1.0.0"
  },
  "breaks": {
    "irisflw": "*"
  }
}
